# ONEX Platform Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_PASSWORD=changeme
OMNIBASE_INFRA_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5436/omnibase_infra

# ---------- Kafka / Redpanda ----------
# Host scripts connect to the external port
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---------- Valkey (Redis-compatible) ----------
VALKEY_URL=redis://localhost:16379

# ---------- Qdrant (Vector DB) ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ---------- LLM Endpoints (optional) ----------
# Configure if you have local LLM inference servers
# LLM_CODER_URL=http://localhost:8000
# LLM_EMBEDDING_URL=http://localhost:8100

# ---------- Feature Flags ----------
ENABLE_REAL_TIME_EVENTS=true
